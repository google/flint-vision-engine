[Unit]
Description=SYMPICS Service Integrity & Process Watchdog
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=sympics
WorkingDirectory=/opt/sympics/image-correlation-suite
ExecStart=/usr/bin/python3 /opt/sympics/image-correlation-suite/scripts/daemons/sympics_watchdog.py --port 8080 --interval 5.0

Restart=always
RestartSec=5s

LimitNOFILE=65536
Environment=PYTHONUNBUFFERED=1
Environment=SYMPICS_PG_DB=sympics_db

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sympics-watchdog

[Install]
WantedBy=multi-user.target
