# ===============================================================================
# SYMPICS FORENSIC PLATFORM - CONFIGURATION TEMPLATE
# ===============================================================================
# Copy this file to .env and adjust variables as needed for your deployment.

# PostgreSQL Connection
SYMPICS_DB_HOST=localhost
SYMPICS_DB_PORT=5432
SYMPICS_DB_NAME=sympics_db
SYMPICS_DB_USER=sympics_user
SYMPICS_DB_PASSWORD=

# Storage Vault Mount Points
SYMPICS_VAULT_ROOT=/path/to/storage_vault
SYMPICS_STAGING_DIR=/path/to/storage_vault/03_Ingestion_Staging
SYMPICS_QUARANTINE_DIR=/path/to/storage_vault/03_Ingestion_Staging/_quarantine

# Web Server & REST API
SYMPICS_WEB_PORT=8080
SYMPICS_WEB_HOST=0.0.0.0
# Optional: SYMPICS automatically authorizes localhost, 127.0.0.1, and LAN IPs on SYMPICS_WEB_PORT.
# Only specify SYMPICS_CORS_ORIGIN if you need to restrict or whitelist specific external domains.
# SYMPICS_CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
